# Copy to .env and fill in. .env is ignored by git; CI reads these from GitHub Secrets.

# Sauce Demo user (shown on https://www.saucedemo.com login page)
SAUCE_USERNAME=
SAUCE_PASSWORD=

# Restful Booker admin (documented at https://restful-booker.herokuapp.com/apidoc)
BOOKER_USERNAME=
BOOKER_PASSWORD=
