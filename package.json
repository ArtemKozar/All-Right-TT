{
  "name": "saucedemo-restful-booker-tests",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright UI tests for Sauce Demo and API tests for Restful Booker",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
